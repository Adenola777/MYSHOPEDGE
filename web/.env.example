# MyShopEdge web. Copy to .env.local and fill in.
#
# Every variable here is NEXT_PUBLIC_, which means they are compiled into the JavaScript
# the browser downloads. Anything put here is public. Never add a secret to this file, and
# never add a DATABASE_URL: the front end reaches the database only through the API, under
# the same authentication and the same row level security as any other client. Rule 4 of
# A13.

# Where the Python service is. Without it, src/lib/api.js falls back to
# http://localhost:8000/v1, which is right for local work and wrong everywhere else. A
# deployment without this serves a front end that calls the developer's own machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# Stripe's publishable key. Public by design: it identifies the account and cannot move
# money. The secret key belongs to the service and never appears here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_...

# Stack Auth, which Neon Auth provisioned. Read from @stackframe/stack 2.8.108 itself: the
# project id is the only value it demands, and without it sign-in is switched off and the
# screens say so. The publishable client key is optional in the package; whether this
# project requires it was not readable, so it is set on Vercel. Both are public by design.
# STACK_SECRET_SERVER_KEY is not used, because the application uses StackClientApp only.
NEXT_PUBLIC_STACK_PROJECT_ID=f1762e29-4750-42f6-80e1-c94b040a72e8
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=the-publishable-client-key-from-the-Neon-Auth-page
