# MyShopEdge API service. Copy to .env and fill in.
#
# Every variable here is read by code in service/app. The list was produced by searching
# the source rather than from memory, so it is what the service actually asks for, not
# what somebody once wrote down. `python3 scripts/check_env.py` verifies a filled copy.
#
# .env and its variants are already in .gitignore. Nothing in this file is a real value.
#
# --------------------------------------------------------------------------------------
# DATABASE
# --------------------------------------------------------------------------------------

# Neon, connecting as mse_app. Never as mse_owner and never as mse_migrator: the service
# must not be able to change its own schema or read the migration ledger.
#
# Migrations are the exception and run with a separate mse_migrator string, passed on the
# command line to scripts/migrate.py and not kept here.
# The database is named myshopedge. It is not neondb, which also exists on the project and
# holds nothing.
DATABASE_URL=postgresql://mse_app:PASSWORD@HOST.eu-west-2.aws.neon.tech/myshopedge?sslmode=require

# Pool size. A28.4 chose a long-lived container, where the defaults below are right.
# On a serverless host set DB_POOL_MAX=1 and point DATABASE_URL at Neon's pooled endpoint,
# which is the hostname carrying -pooler. A pool of ten per invocation exhausts Postgres
# long before the platform notices.
DB_POOL_MIN=1
DB_POOL_MAX=10

# --------------------------------------------------------------------------------------
# IDENTITY
# --------------------------------------------------------------------------------------

# Neon Auth provisions Stack Auth, which signs ES256. These three are configured and never
# derived. A25.2 records what happened when they were derived: the JWKS URL was built by
# appending a path to the Neon host, and the real one is on api.stack-auth.com with a Stack
# Auth project id in it. No amount of concatenation reaches that.
NEON_AUTH_JWKS_URL=https://api.stack-auth.com/api/v1/projects/f1762e29-4750-42f6-80e1-c94b040a72e8/.well-known/jwks.json

# Issuer and audience must be read off one real token before launch. They have never been
# observed here, because no real token has reached this service. Guessing them either
# refuses every valid token or, worse, accepts one issued for somebody else.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=

# Optional. Only used to build sign-in links, never to derive any of the above.
NEON_AUTH_BASE_URL=

# --------------------------------------------------------------------------------------
# BILLING
# --------------------------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# The three live prices, created 23 September 2026 in acct_1RtsbgKUYBix7r5t. A price
# identifier is not a secret: Stripe Checkout sends it from the browser by design.
STRIPE_PRICE_STARTER=price_1UIp77KUYBix7r5t8CZvvdaj
STRIPE_PRICE_GROWTH=price_1UIp7CKUYBix7r5tVgIsyIfC
STRIPE_PRICE_PRO=price_1UIp7EKUYBix7r5t8LIvxFd6

# --------------------------------------------------------------------------------------
# TIKTOK SHOP
# --------------------------------------------------------------------------------------

# service_id is NOT app_key. A23.2. Both sit on the app detail page in Partner Center under
# App and Service, and they are routinely confused. service_id builds the authorisation
# link. app_key and app_secret sign requests and exchange the code.
TIKTOK_SERVICE_ID=7688277529379407633
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# 32 random bytes, base64. Encrypts the TikTok access token, refresh token and shop cipher
# with AES-256-GCM before they reach the database.
#
# GENERATE THIS ONCE AND NEVER REGENERATE IT. Every token already stored becomes
# permanently unreadable the moment this changes, and every seller has to reconnect.
#
#   python3 scripts/check_env.py --generate-key
TIKTOK_TOKEN_KEY=

# --------------------------------------------------------------------------------------
# NOT FOR NORMAL USE
# --------------------------------------------------------------------------------------

# scripts/setup_stripe.py refuses to write to a live Stripe account unless this is "yes".
# Leave it unset. Stripe prices are immutable once created.
# I_MEAN_LIVE=
